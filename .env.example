APP_NAME="SPP-Ku"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000
APP_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- DATABASE (XAMPP / MySQL) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spp_ku
DB_USERNAME=root
DB_PASSWORD=

# --- Alternatif tanpa MySQL (cukup hapus tanda # dan beri # pada blok MySQL di atas) ---
# DB_CONNECTION=sqlite

# Cost bcrypt disamakan dengan hash di database/spp_ku.sql
BCRYPT_ROUNDS=10

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
FILESYSTEM_DISK=local

# Aturan denda perpustakaan
SPPKU_DENDA_PER_HARI=2000
SPPKU_DURASI_PINJAM=7
# Batas waktu siswa datang mengambil buku setelah mengajukan (jam). Lewat batas = ditolak otomatis.
SPPKU_BATAS_AMBIL_JAM=24
# Siswa diingatkan mulai berapa hari sebelum jatuh tempo (perpanjang atau kembalikan).
SPPKU_PENGINGAT_HARI=2
